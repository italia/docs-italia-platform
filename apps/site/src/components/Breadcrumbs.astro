---
import { breadcrumbs } from '@italia-tailwind/recipes';

interface Props {
  items: Array<{ label: string; href?: string }>;
}
// le recipes fanno l'escape delle etichette, che vengono dai documenti
const items = [{ label: 'Docs Italia', href: '/' }, ...Astro.props.items];
---
<Fragment set:html={breadcrumbs({ items })} />
