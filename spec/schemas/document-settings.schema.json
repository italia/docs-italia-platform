{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "document": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "tags": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "short_name": {
          "type": "string"
        },
        "language": {
          "type": "string"
        },
        "format": {
          "default": "rst",
          "type": "string",
          "enum": [
            "rst",
            "myst"
          ]
        },
        "source": {
          "default": ".",
          "type": "string"
        },
        "languages": {
          "default": [
            "it"
          ],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "versions": {
          "type": "object",
          "properties": {
            "draft": {
              "type": "string"
            },
            "releases": {
              "default": "tags",
              "type": "string",
              "enum": [
                "tags",
                "github-releases",
                "none"
              ]
            },
            "default": {
              "default": "latest-release",
              "type": "string"
            }
          }
        },
        "downloads": {
          "default": [
            "pdf",
            "epub",
            "html"
          ],
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "pdf",
              "epub",
              "html"
            ]
          }
        },
        "publisher": {
          "type": "string"
        },
        "project": {
          "type": "string"
        },
        "repository": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "name",
        "description",
        "tags"
      ],
      "additionalProperties": {}
    }
  },
  "required": [
    "document"
  ]
}
