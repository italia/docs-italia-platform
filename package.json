{
  "name": "docs-italia-platform",
  "version": "0.0.0",
  "private": true,
  "description": "Nuova piattaforma di Docs Italia: toolkit dei documenti, server, sito, editor, RAG e server MCP",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "packages/schema",
    "packages/myst",
    "packages/render",
    "packages/export",
    "packages/retrieval",
    "packages/forge",
    "packages/toolkit",
    "apps/server",
    "apps/mcp",
    "apps/site",
    "apps/editor",
    "apps/dashboard"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p apps/editor && tsc --noEmit -p apps/dashboard",
    "docs-italia": "bun packages/toolkit/bin/docs-italia.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "typescript": "^5.9.3"
  }
}
